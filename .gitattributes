# Normalise line endings so a Windows checkout cannot commit CRLF.
* text=auto

# These are executed on Linux and MUST be LF.
#
# `deploy/remote-deploy.sh` is piped into `bash -s` over SSH. A CRLF copy fails
# with errors like `$'\r': command not found` — which name a line that looks
# perfectly correct, and cost far more time to diagnose than this file cost to
# write. The Dockerfile and compose file are read inside Linux containers for
# the same reason.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Generated binaries — never touch these.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.woff2         binary
